const express = require('express');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const Student = require('../models/Student');
const { requireRole } = require('../middleware/auth');

const router = express.Router();
const uploadDir = path.join(__dirname, '..', 'uploads');

// Photo upload settings: JPG/PNG/WEBP only, max 2MB
const upload = multer({
  storage: multer.diskStorage({
    destination: (r, f, cb) => cb(null, uploadDir),
    filename: (r, f, cb) => cb(null, Date.now() + '-' + Math.round(Math.random() * 1e6) + path.extname(f.originalname).toLowerCase())
  }),
  limits: { fileSize: 2 * 1024 * 1024 },
  fileFilter: (r, f, cb) => {
    if (/^image\/(jpeg|png|webp)$/.test(f.mimetype)) return cb(null, true);
    const err = new Error('Only JPG, PNG or WEBP images are allowed'); err.status = 400; cb(err);
  }
});

const removeFile = (p) => {
  if (p && p.startsWith('/uploads/')) fs.unlink(path.join(uploadDir, path.basename(p)), () => {});
};
const populate = 'course section';

router.get('/', async (req, res, next) => {
  try {
    const filter = {};
    ['gradeLevel', 'course', 'section', 'enrollmentStatus', 'gender'].forEach((k) => { if (req.query[k]) filter[k] = req.query[k]; });
    if (req.query.q) {
      const rx = new RegExp(String(req.query.q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
      filter.$or = ['studentId', 'firstName', 'middleName', 'lastName'].map((f) => ({ [f]: rx }));
    }
    res.json(await Student.find(filter).populate(populate).sort('lastName firstName'));
  } catch (e) { next(e); }
});

router.get('/:id', async (req, res, next) => {
  try {
    const s = await Student.findById(req.params.id).populate(populate);
    if (!s) return res.status(404).json({ message: 'Student not found' });
    res.json(s);
  } catch (e) { next(e); }
});

router.post('/', upload.single('photo'), async (req, res, next) => {
  try {
    const body = { ...req.body };
    Object.keys(body).forEach((k) => body[k] === '' && delete body[k]);
    if (req.file) body.photo = '/uploads/' + req.file.filename;
    const s = await Student.create(body);
    res.status(201).json(await Student.findById(s._id).populate(populate));
  } catch (e) {
    if (req.file) removeFile('/uploads/' + req.file.filename); // do not keep photo if save failed
    next(e);
  }
});

router.put('/:id', upload.single('photo'), async (req, res, next) => {
  try {
    const s = await Student.findById(req.params.id);
    if (!s) { if (req.file) removeFile('/uploads/' + req.file.filename); return res.status(404).json({ message: 'Student not found' }); }
    for (const k in req.body) {
      if (['_id', '__v', 'photo'].includes(k)) continue;
      s.set(k, req.body[k] === '' ? undefined : req.body[k]);
    }
    const oldPhoto = s.photo;
    if (req.file) s.photo = '/uploads/' + req.file.filename;
    await s.save();
    if (req.file) removeFile(oldPhoto);
    res.json(await Student.findById(s._id).populate(populate));
  } catch (e) {
    if (req.file) removeFile('/uploads/' + req.file.filename);
    next(e);
  }
});

router.delete('/:id', requireRole('admin'), async (req, res, next) => {
