import { useEffect, useState } from 'react';
import { Printer } from 'lucide-react';
import api, { errMsg } from '../api';
import { useToast } from '../context.jsx';
import { GRADES, STATUS, fullName } from './Students.jsx';

const TABS = [['students', 'Student list'], ['enrollments', 'Enrollment report'], ['academic', 'Academic report']];

export default function Reports() {
  const notify = useToast();
  const [tab, setTab] = useState('students');
  const [filter, setFilter] = useState('');
  const [rows, setRows] = useState([]);

  useEffect(() => { setFilter(''); }, [tab]);
  useEffect(() => {
    const endpoint = { students: '/students', enrollments: '/enrollments', academic: '/grades' }[tab];
    const key = { students: 'gradeLevel', enrollments: 'status', academic: 'schoolYear' }[tab];
    const params = filter ? { [key]: filter } : {};
    api.get(endpoint, { params }).then((r) => setRows(r.data)).catch((e) => notify(errMsg(e), 'error'));
  }, [tab, filter, notify]);

  // Academic summary: average grade per student
  const summary = Object.values(rows.reduce((acc, g) => {
    if (!g.student) return acc;
    const k = g.student._id;
    acc[k] = acc[k] || { student: g.student, count: 0, sum: 0 };
    acc[k].count += 1; acc[k].sum += g.grade;
    return acc;
  }, {}));

  return (
    <div>
      <div className="page-head no-print"><h1>Reports</h1>
        <button className="btn" onClick={() => window.print()}><Printer size={16} /> Print report</button></div>

      <div className="card toolbar no-print">
        {TABS.map(([k, label]) => <button key={k} className={'tab' + (tab === k ? ' active' : '')} onClick={() => setTab(k)}>{label}</button>)}
        {tab === 'students' && <select value={filter} onChange={(e) => setFilter(e.target.value)}><option value="">All grade levels</option>{GRADES.map((g) => <option key={g}>{g}</option>)}</select>}
        {tab === 'enrollments' && <select value={filter} onChange={(e) => setFilter(e.target.value)}><option value="">All statuses</option>{STATUS.map((g) => <option key={g}>{g}</option>)}</select>}
        {tab === 'academic' && <input placeholder="School year e.g. 2026-2027" value={filter} onChange={(e) => setFilter(e.target.value)} />}
      </div>

      <div className="card pad report">
        <h2>{TABS.find((t) => t[0] === tab)[1]}</h2>
        <p className="muted">Generated on {new Date().toLocaleString()} - {rows.length} record(s)</p>

        {tab === 'students' && <table><thead><tr><th>Student ID</th><th>Name</th><th>Gender</th><th>Grade level</th><th>Course</th><th>Section</th><th>Status</th></tr></thead>
          <tbody>{rows.map((s) => <tr key={s._id}><td>{s.studentId}</td><td>{fullName(s)}</td><td>{s.gender}</td><td>{s.gradeLevel}</td><td>{s.course?.code || '-'}</td><td>{s.section?.name || '-'}</td><td>{s.enrollmentStatus}</td></tr>)}</tbody></table>}

        {tab === 'enrollments' && <table><thead><tr><th>Student</th><th>School year</th><th>Semester</th><th>Course</th><th>Section</th><th>Status</th></tr></thead>
          <tbody>{rows.map((e) => <tr key={e._id}><td>{e.student ? `${e.student.studentId} - ${fullName(e.student)}` : '-'}</td><td>{e.schoolYear}</td><td>{e.semester}</td><td>{e.course?.code || '-'}</td><td>{e.section?.name || '-'}</td><td>{e.status}</td></tr>)}</tbody></table>}

        {tab === 'academic' && (<>
          <h4>Average grade per student</h4>
          <table><thead><tr><th>Student ID</th><th>Name</th><th>Subjects</th><th>Average</th><th>Remarks</th></tr></thead>
            <tbody>{summary.map((s) => { const avg = s.sum / s.count; return (
              <tr key={s.student._id}><td>{s.student.studentId}</td><td>{fullName(s.student)}</td><td>{s.count}</td><td>{avg.toFixed(2)}</td><td>{avg >= 75 ? 'Passed' : 'Failed'}</td></tr>); })}</tbody></table>
          <h4>All grades</h4>
          <table><thead><tr><th>Student</th><th>Subject</th><th>School year</th><th>Semester</th><th>Grade</th><th>Remarks</th></tr></thead>
            <tbody>{rows.map((g) => <tr key={g._id}><td>{g.student ? fullName(g.student) : '-'}</td><td>{g.subject?.name}</td><td>{g.schoolYear}</td><td>{g.semester}</td><td>{g.grade}</td><td>{g.remarks}</td></tr>)}</tbody></table>
        </>)}
        {!rows.length && <p className="empty">No records found for this report.</p>}
      </div>
    </div>
  );
}
