  const openForm = (row) => {
    const init = {};
    fields.forEach((f) => {
      let v = row ? row[f.name] : undefined;
      if (v && typeof v === 'object' && v._id) v = v._id;
      if (f.type === 'date' && v) v = String(v).slice(0, 10);
      if (f.type === 'file' || f.type === 'password') v = f.type === 'file' ? null : '';
      init[f.name] = v ?? f.default ?? '';
    });
    setForm(init); setErrors({}); setEditing(row || {});
  };

  const validate = () => {
    const e = {};
    fields.forEach((f) => {
      const v = form[f.name];
      const empty = v === '' || v == null;
      if (f.required && empty && !(f.type === 'password' && editing._id)) { e[f.name] = f.label + ' is required'; return; }
      if (empty) return;
      if (f.type === 'email' && !emailRx.test(v)) e[f.name] = 'Enter a valid email address';
      if (f.type === 'number') {
        const n = Number(v);
        if (isNaN(n) || (f.min != null && n < f.min) || (f.max != null && n > f.max)) e[f.name] = `${f.label} must be a number from ${f.min} to ${f.max}`;
      }
      if (f.pattern && !f.pattern.test(v)) e[f.name] = f.patternMsg || 'Invalid format';
      if (f.type === 'password' && v.length < 6) e[f.name] = 'Password must be at least 6 characters';
      if (f.type === 'file' && v.size > 2 * 1024 * 1024) e[f.name] = 'Image must be 2MB or smaller';
    });
    setErrors(e);
    return !Object.keys(e).length;
  };

  const submit = async (ev) => {
    ev.preventDefault();
    if (!validate()) return;
    setSaving(true);
    try {
      let payload = { ...form };
      if (fields.some((f) => f.type === 'file')) {        // forms with a photo are sent as FormData
        payload = new FormData();
        Object.entries(form).forEach(([k, v]) => {
          if (v instanceof File) payload.append(k, v);
          else if (v !== null && v !== undefined) payload.append(k, v);
        });
      }
      if (editing._id) { await api.put(`${endpoint}/${editing._id}`, payload); notify('Changes saved'); }
      else { await api.post(endpoint, payload); notify('Record added'); }
      setEditing(null);
      load();
    } catch (e) { notify(errMsg(e), 'error'); }
    setSaving(false);
  };

  const doDelete = async () => {
    try { await api.delete(`${endpoint}/${deleting._id}`); notify('Record deleted'); load(); }
    catch (e) { notify(errMsg(e), 'error'); }
    setDeleting(null);
  };

  return (
    <div>
      <div className="page-head">
        <h1>{title}</h1>
        <button className="btn" onClick={() => openForm(null)}><Plus size={16} /> Add new</button>
      </div>

      <div className="card toolbar">
        {searchable && (
          <div className="search"><Search size={16} />
            <input placeholder="Search..." value={q} onChange={(e) => setQ(e.target.value)} />
          </div>
        )}
        {filters.map((f) => (
          <select key={f.name} value={filterValues[f.name] || ''} onChange={(e) => setFilterValues({ ...filterValues, [f.name]: e.target.value })}>
            <option value="">All {f.label}</option>
            {optionsOf(f).map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
          </select>
        ))}
      </div>

      <div className="card table-wrap">
        <table>
          <thead><tr>{columns.map((c) => <th key={c.label}>{c.label}</th>)}<th className="right">Actions</th></tr></thead>
          <tbody>
            {loading && <tr><td colSpan={columns.length + 1} className="empty">Loading...</td></tr>}
            {!loading && !rows.length && <tr><td colSpan={columns.length + 1} className="empty">No records found. Click "Add new" to create one.</td></tr>}
            {!loading && rows.map((r) => (
              <tr key={r._id}>
                {columns.map((c) => <td key={c.label}>{c.render ? c.render(r) : r[c.key]}</td>)}
                <td className="right nowrap">
                  {View && <button className="icon-btn" title="View" onClick={() => setViewing(r)}><Eye size={16} /></button>}
                  <button className="icon-btn" title="Edit" onClick={() => openForm(r)}><Pencil size={16} /></button>
                  {user.role === 'admin' && <button className="icon-btn red" title="Delete" onClick={() => setDeleting(r)}><Trash2 size={16} /></button>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {editing && (
        <Modal title={(editing._id ? 'Edit ' : 'Add ') + title} onClose={() => setEditing(null)} wide>
          <form onSubmit={submit} noValidate>
            <div className="form-grid">
              {fields.map((f) => (
                <div key={f.name} className={'field' + (f.full ? ' full' : '')}>
                  <label>{f.label}{f.required && <span className="req"> *</span>}</label>
                  {f.type === 'select' ? (
                    <select value={form[f.name]} onChange={(e) => setForm({ ...form, [f.name]: e.target.value })}>
                      <option value="">-- Select --</option>
                      {optionsOf(f).map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
                    </select>
                  ) : f.type === 'file' ? (
                    <input type="file" accept="image/png,image/jpeg,image/webp" onChange={(e) => setForm({ ...form, [f.name]: e.target.files[0] || null })} />
                  ) : (
                    <input type={f.type || 'text'} value={form[f.name]} placeholder={f.type === 'password' && editing._id ? 'Leave blank to keep current' : f.placeholder}
                      onChange={(e) => setForm({ ...form, [f.name]: e.target.value })} />
                  )}
                  {errors[f.name] && <small className="err">{errors[f.name]}</small>}
                </div>
              ))}
            </div>
            <div className="actions">
              <button type="button" className="btn ghost" onClick={() => setEditing(null)}>Cancel</button>
              <button className="btn" disabled={saving}>{saving ? 'Saving...' : 'Save'}</button>
            </div>
          </form>
        </Modal>
      )}

      {viewing && View && <Modal title={title + ' details'} onClose={() => setViewing(null)} wide><View row={viewing} /></Modal>}
      {deleting && <Confirm message="This record will be permanently deleted. Do you want to continue?" onYes={doDelete} onNo={() => setDeleting(null)} />}
    </div>
  );
}
