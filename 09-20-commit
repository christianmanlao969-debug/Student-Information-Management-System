const crud = require('../utils/crud');
const Enrollment = require('../models/Enrollment');
const Student = require('../models/Student');

// After saving an enrollment, copy the newest enrollment info to the student record
async function syncStudent(doc) {
  const latest = await Enrollment.findOne({ student: doc.student }).sort({ schoolYear: -1, createdAt: -1 });
  if (!latest || String(latest._id) !== String(doc._id)) return; // editing old history: leave student alone
  const update = { enrollmentStatus: doc.status };
  if (doc.course) update.course = doc.course;
  if (doc.section) update.section = doc.section;
  await Student.findByIdAndUpdate(doc.student, update);
}

module.exports = crud(Enrollment, { populate: 'student course section', afterSave: syncStudent });
