app.use('/uploads', express.static(path.join(__dirname, 'uploads')));

app.use('/api/auth', require('./routes/auth'));
app.use('/api/dashboard', protect, require('./routes/dashboard'));
app.use('/api/students', protect, require('./routes/students'));
app.use('/api/enrollments', protect, require('./routes/enrollments'));
app.use('/api/courses', protect, require('./routes/courses'));
app.use('/api/sections', protect, require('./routes/sections'));
app.use('/api/subjects', protect, require('./routes/subjects'));
app.use('/api/grades', protect, require('./routes/grades'));
app.use('/api/users', protect, requireRole('admin'), require('./routes/users'));

app.use((req, res) => res.status(404).json({ message: 'Route not found' }));

// One place that turns any error into a helpful message
app.use((err, req, res, next) => {
  let status = err.status || 500;
  let message = err.message || 'Server error';
  if (err.name === 'ValidationError') { status = 400; message = Object.values(err.errors).map((e) => e.message).join('. '); }
  else if (err.code === 11000) { status = 400; message = 'A record with the same ' + Object.keys(err.keyPattern || {}).join(', ') + ' already exists'; }
  else if (err.name === 'CastError') { status = 400; message = 'Invalid value for ' + err.path; }
  else if (err.name === 'MulterError') { status = 400; message = err.code === 'LIMIT_FILE_SIZE' ? 'Image must be 2MB or smaller' : err.message; }
  else if (status === 500) console.error(err);
  res.status(status).json({ message });
});

const PORT = process.env.PORT || 5000;
connectDB().then(() => app.listen(PORT, () => console.log('Server running on http://localhost:' + PORT)));
````

